# agent-office configuration (all optional; flags of `agent-office serve` override these).
# Never put secrets in this file.

# Listen address. Must be a loopback address.
AGENT_OFFICE_ADDR=127.0.0.1:7680
# Repository agents work on; each agent gets its own worktree of it (ADR 0010).
AGENT_OFFICE_REPO=
# Database and agent worktrees. Default: $XDG_DATA_HOME/agent-office (~/.local/share/agent-office).
AGENT_OFFICE_DATA_DIR=
# Agents running at the same time (1-32).
AGENT_OFFICE_MAX_AGENTS=4
# Model for agents, e.g. haiku. Empty = Claude Code's default.
AGENT_OFFICE_MODEL=
# Claude Code binary (name on PATH or absolute path).
AGENT_OFFICE_CLAUDE_BIN=claude
# Host mode: agents also load your own Claude Code settings and hooks (ADR 0003).
AGENT_OFFICE_INHERIT_USER_SETTINGS=true
# How agents run (ADR 0007): podman = rootless Podman workers (default; agents run with full
# permissions only inside the container); host = unsandboxed on this machine, permission prompts on.
AGENT_OFFICE_SANDBOX=podman
# Extra host names sandboxed agents may reach over HTTPS, comma-separated (.example.com for
# subdomains). Added to the stack pack's hosts or, without a pack, to the default
# proxy.golang.org, sum.golang.org, registry.npmjs.org (ADR 0016, 0023).
AGENT_OFFICE_EGRESS_ALLOW=
# Stack pack for sandboxed agents (Phase 6, ADR 0023, docs/packs.md): worker image, egress hosts,
# secrets, skills, MCP servers. Built in: go, node; `agent-office pack list` shows all. Empty: the
# base image (no language toolchain). Build its image with `agent-office worker-image --pack <name>`.
AGENT_OFFICE_PACK=
# Your stack packs, one directory each. Default: $XDG_CONFIG_HOME/agent-office/packs.
AGENT_OFFICE_PACKS_DIR=
# Values of the pack's env vars: one user-only file per name (mode 0600, directory 0700), never
# values in this file. Default: $XDG_CONFIG_HOME/agent-office/secrets.
AGENT_OFFICE_SECRETS_DIR=
# Limits per sandboxed worker.
AGENT_OFFICE_SANDBOX_MEMORY=2g
AGENT_OFFICE_SANDBOX_PIDS=256
# Sandboxed agents (Phase 3): path of the file holding the Claude Code OAuth token from
# `claude setup-token`. A path, never the token. Mode 0600, directory 0700 (ADR 0015).
# Default: $XDG_CONFIG_HOME/agent-office/oauth-token (~/.config/agent-office/oauth-token).
AGENT_OFFICE_OAUTH_TOKEN_FILE=
# GitHub loop (Phase 5, ADR 0020-0022). Off by default: with it on, the daemon pushes finished
# work and opens pull requests. Merging always stays with you.
AGENT_OFFICE_GITHUB=false
# Remote of AGENT_OFFICE_REPO to push to (over your own SSH setup); its URL names the GitHub
# repository (git@<host-or-alias>:owner/name.git). Pull requests target that repository's
# default branch.
AGENT_OFFICE_GITHUB_REMOTE=origin
# Path of the file holding a fine-grained GitHub token for that repository. A path, never the
# token. Mode 0600, directory 0700. Permissions: Metadata read, Pull requests read/write,
# Commit statuses read, Checks read (if offered). No Contents write: pushes go over SSH, and
# without it the token cannot merge.
# Default: $XDG_CONFIG_HOME/agent-office/github-token (~/.config/agent-office/github-token).
AGENT_OFFICE_GITHUB_TOKEN_FILE=
# Who reviews pull requests: internal (a sandboxed reviewer agent), coderabbit (the CodeRabbit
# GitHub App, installed on the repository by you) or none.
AGENT_OFFICE_REVIEWER=internal
# Review feedback rounds sent to the original worker automatically per pull request (0-5).
AGENT_OFFICE_REVIEW_ROUNDS=2
# debug | info | warn
AGENT_OFFICE_LOG_LEVEL=info

# Set by the daemon for each agent (inside sandboxed workers too); do not set them yourself.
# AGENT_OFFICE_SOCKET=
# AGENT_OFFICE_MCP_SOCKET=
# AGENT_OFFICE_EGRESS_SOCKET=
# AGENT_OFFICE_API_SOCKET=
# AGENT_OFFICE_SECRETS_SOCKET=
# AGENT_OFFICE_CO_AUTHOR=
