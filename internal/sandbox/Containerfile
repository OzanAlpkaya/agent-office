# agent-office base worker image (ADR 0007, 0016, 0023). Built locally with
# `agent-office worker-image` (or `make worker-image`); the tag is derived from this file, so a
# change means a rebuild.
#
# This is the default image for projects without a stack pack, and the base every pack image is
# built FROM (`FROM ${BASE_IMAGE}`): workers rely on what it provides (git for the agent and the
# helper containers, CA certificates for HTTPS through the egress proxy, glibc for the mounted
# claude binary). It carries no language toolchain; packs add one (internal/pack/builtin).
# Deliberately absent: openssh-client (no SSH; pushing is the daemon's job, ADR 0014).
FROM docker.io/library/debian:trixie-slim@sha256:7378260c0a098d27ac206225db5e7d92b8c7c84ea7afccc86eeb513756bbd392

# ca-certificates is not in Debian slim; git and curl need it for HTTPS through the CONNECT
# proxy. --no-install-recommends keeps git's recommended openssh-client out.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates git curl ripgrep \
 && rm -rf /var/lib/apt/lists/*

LABEL io.agent-office.image=worker
